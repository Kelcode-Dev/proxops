[Unit]
Description=proxops — Git → Proxmox GitOps reconciler
Documentation=https://github.com/GizzmoShifu/proxmox-operator
After=network-online.target
Wants=network-online.target
# Do NOT start if no PVE API credentials are configured — the agent would
# abort every cycle. Override with `EnvironmentFile=` or a drop-in.
ConditionPathExists=/etc/proxops/proxops.yaml

[Service]
Type=simple
User=proxops
Group=proxops
# Binary + config. Adjust paths to your install layout.
ExecStart=/usr/local/bin/proxops run --config /etc/proxops/proxops.yaml
Restart=on-failure
RestartSec=5s

# Secrets come only from the environment (see docs/OPERATIONS.md).
#
# Bootstrap (env credentials):
# Option A: an env file (root-only 0600):
EnvironmentFile=-/etc/proxops/proxops.env
# /etc/proxops/proxops.env (0600 root:proxops), e.g.:
#   PROXOPS_PVE_TOKEN_VALUE=root@pam!proxops=<uuid>
#   PROXOPS_GIT_TOKEN=<ghp_...>
# Option B: an inline drop-in:
#   echo 'Environment="PROXOPS_PVE_TOKEN_VALUE=root@pam!proxops=..."' > \
#         /etc/systemd/system/proxops.service.d/cred.conf
#   echo 'Environment="PROXOPS_GIT_TOKEN=..."' >> same file
#
# SOPS-backed cluster-local config (recommended):
# point ExecStart at the cluster-local config inside the GitOps checkout,
# and supply the private age key by path (OUTSIDE the repository):
#   ExecStart=/usr/local/bin/proxops run \
#     --config /var/lib/proxops/gitops/clusters/conformance-dev/config.yaml
#   /var/lib/proxops/age/conformance-dev.age (0600 proxops:proxops)
#   Environment=SOPS_AGE_KEY_FILE=/var/lib/proxops/age/conformance-dev.age
# The repo's clusters/<name>/secrets.sops.yaml carries only the ENCRYPTED
# values + the public age recipient (sops metadata) — never the private key.
# Requires sops + age on PATH (see docs/OPERATIONS.md → "Per-cluster SOPS
# secrets").

# Hardening
NoNewPrivileges=true
ProtectHome=read-only      # agent's git cache lives under /home/proxops
PrivateTmp=true
ProtectSystem=full         # read-only /usr /boot /efi /etc; home + tmp writable
ReadWritePaths=/home/proxops/.local/share/proxops

# The agent exposes /healthz (2 min staleness window) — enable watchdogs if
# you prefer liveness via the endpoint; keep the default 45s timeout above.
# WatchdogSec=45

[Install]
WantedBy=multi-user.target
